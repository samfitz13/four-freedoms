# ---------------------------------------------------------------------------
# freedom-four env template. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Public site URL (used for auth callback construction).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres — local dev via `pnpm db:up`, or a Supabase/PlanetScale connection string.
DATABASE_URL=postgres://freedom:freedom@127.0.0.1:5432/freedom_four
# Optional macOS Keychain service containing a full DATABASE_URL.
# pnpm app/database commands load it without storing the credential in this file.
# An explicitly exported DATABASE_URL takes precedence.
DATABASE_URL_KEYCHAIN_SERVICE=

# better-auth
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Optional — defaults to NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend). Leave blank in dev — emails will be logged to stdout.
RESEND_API_KEY=
EMAIL_FROM="freedom-four <noreply@freedom-four.app>"

# PostHog — optional analytics (PR 7)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Calendar — optional. Leave blank to disable the calendar connect flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/time/calendar/callback
